# Server Port (Railway sets process.env.PORT automatically)
PORT=3000

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
FRONTEND_URL=https://walleta-finance.vercel.app,http://localhost:5173,http://localhost:5174

# Database Configuration (Optional - if omitted or unreachable, backend runs safely on mock simulated data)
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
